{
  "project": {
    "name": "rice_quality_loci",
    "description": "Bidirectional attention-based differential locus discovery in selected rice candidate regions"
  },
  "paths": {
    "data_dir": "Data",
    "results_dir": "Results",
    "vcf": "Data/glutinous.vcf.gz",
    "vcf_index": "Data/glutinous.vcf.gz.tbi",
    "phenotype": "Data/glutinous.tsv",
    "reference_fasta": "Data/osa1_r7.asm.fa.gz",
    "reference_fasta_fai": "Data/osa1_r7.asm.fa.gz.fai",
    "reference_fasta_gzi": "Data/osa1_r7.asm.fa.gz.gzi",
    "gene_annotation": "Data/chr06.gff3.gz",
    "grain_length_gene_annotation": "Data/chr03.gff3.gz",
    "grain_length_matrix_dir": "Results/grain_length/attention/04_attention_matrices",
    "grain_length_vcf": "Data/grain_length.vcf.gz",
    "grain_length_vcf_index": "Data/grain_length.vcf.gz.tbi",
    "grain_length_phenotype": "Data/grain_length.tsv",
    "candidate_regions": "Data/glutinous_regions.bed",
    "grain_length_regions": "Data/grain_length_regions.bed",
    "model": "Data/OneGenomeRice_model"
  },
  "workflow": {
    "chromosome": 6,
    "window_size": 8000,
    "stride": 4000,
    "region_names": [
      "Region 1",
      "Region 2",
      "Region 3",
      "Region 4"
    ],
    "matrix_files": [
      "hap1_attention_collapsed.csv",
      "hap1_attention_collapsed_revcomp.csv"
    ],
    "gene_metric_top_n": 8,
    "gene_metrics_for_summary": [
      "peak_density",
      "shannon_entropy"
    ],
    "target_genes": {
      "LOC_Os06g04200": "Wx",
      "LOC_Os06g12450": "ALK"
    },
    "grain_length": {
      "chromosome": 3,
      "start_block": 1,
      "end_block": 10,
      "slice_start": 2002,
      "slice_end": 6001,
      "phenotype_column": "grain_length",
      "n_pcs": 5
    },
    "reference_download": {
      "url": "https://rice.uga.edu/osa1r7_download/osa1_r7.asm.fa.gz"
    }
  },
  "environment": {
    "conda_env": "",
    "conda_sh": "",
    "required_python_modules": [
      "Bio",
      "cyvcf2",
      "matplotlib",
      "numpy",
      "pandas",
      "pysam",
      "scipy",
      "seaborn",
      "statsmodels",
      "torch",
      "tqdm",
      "transformers"
    ]
  }
}
